{
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "useGitignore": true,
  "ignoreRegExpList": [
    "/_[A-Za-z0-9]+/"
  ],
  "ignorePaths": [
    ".git/**",
    "node_modules/**",
    "**/node_modules/**",
    "Build/Intermediate/**",
    "Build/Workbooks-*/**",
    "Build/Resources-*/**",
    "Chapters/test/**",
    "**/*.cls",
    "**/*.sty",
    "bun.lock",
    "package-lock.json",
    "project-words.txt",
    "**/*.{png,jpg,jpeg,gif,bmp,ico,svg,pdf,ai,graffle,ttf,otf,woff,woff2,db,acorn,pkl,mp4,mp3,wav}"
  ]
}
